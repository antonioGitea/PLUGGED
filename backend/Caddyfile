:80 {
    # Storage -> Archivos públicos (portadas, avatares, audios, etc)
    handle /storage/* {
        root * /var/www/storage/app/public
        file_server
    }

    # API -> PHP
    handle /api/* {
        root * /var/www/public
        php_fastcgi php:9000
    }

    # SPA Frontend -> Dist con fallback a index.html
    handle {
        root * /var/www/public/dist
        try_files {path} /index.html
        file_server
    }
}